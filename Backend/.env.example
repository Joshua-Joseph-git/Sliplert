HOST=0.0.0.0
PORT=8000

TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
ALERT_COOLDOWN_SECONDS=60

# Email alerts. Without these, the Pi mails the recipient's server directly on port 25,
# which most home internet providers block and Gmail usually rejects or marks as spam.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 letters below.
SMTP_EMAIL=your.sliplert.account@gmail.com
SMTP_PASSWORD=your_16_letter_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

ROBOT_LEFT_FORWARD_PIN=17
ROBOT_LEFT_BACKWARD_PIN=18
ROBOT_RIGHT_FORWARD_PIN=22
ROBOT_RIGHT_BACKWARD_PIN=23
# Wiring fixes - run `python motor_test.py` (car lifted up) to see which ones you need
ROBOT_REVERSE_LEFT=1
ROBOT_REVERSE_RIGHT=1
ROBOT_SWAP_SIDES=0
# Only if ENA/ENB are wired to Pi pins instead of having the jumpers on:
# ROBOT_LEFT_ENABLE_PIN=12
# ROBOT_RIGHT_ENABLE_PIN=13
ROBOT_PWM=0

ROBOT_CAMERA=on
CAMERA_INDEX=0
POSE_MODEL_COMPLEXITY=0
FALL_CONFIRM_FRAMES=3

AUTONOMOUS_ON_START=on
# Robot stops driving forward once the person is about this close (estimated from shoulder width)
FOLLOW_TARGET_CM=70
FOLLOW_MIN_CM=40
# Length of each turning burst; raise if turns are too weak, lower if it overshoots
TURN_PULSE_S=0.12
SEARCH_TIMEOUT_S=25
# Only used when ROBOT_PWM=1 (0.0 - 1.0)
MOTOR_SPEED=1.0

FALL_VELOCITY_THRESHOLD=2.0
FALL_BODY_ANGLE_THRESHOLD=60
POSITION_HISTORY_LIMIT=10
