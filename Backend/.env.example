TURN_SPEED=0.35

SENSOR_TYPE=NONE
SENSOR_FRONT_ECHO=24
SENSOR_FRONT_TRIGGER=25
SENSOR_LEFT_ECHO=27
SENSOR_LEFT_TRIGGER=16
SENSOR_RIGHT_ECHO=20
SENSOR_RIGHT_TRIGGER=21

MOTOR_VOLTAGE=6
MOTOR_SPEED_DEFAULT=0.5

FALL_VELOCITY_THRESHOLD=2.0
FALL_BODY_ANGLE_THRESHOLD=60
POSITION_HISTORY_LIMIT=10
